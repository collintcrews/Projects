---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

// Fetch all blog posts and sort by date
const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="Projects" description={SITE_DESCRIPTION} />
        <style>
            body {
                font-family: system-ui, -apple-system, sans-serif;
                margin: 0;
                padding: 0;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                color: rgb(var(--black));
                background: rgb(var(--background));
            }
            header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 1.5rem 2rem;
                background-color: #ace1af;
                color: #1b3b2b;
            }
            header h2 {
                margin: 0;
                font-size: 1.25rem;
            }
            header h2 a {
                text-decoration: none;
                color: #1b3b2b;
            }
            main {
                flex: 1;
                width: 960px;
                max-width: calc(100% - 2rem);
                margin: auto;
                padding: 3rem 0;
            }
            ul {
                display: flex;
                flex-wrap: wrap;
                gap: 2rem;
                list-style-type: none;
                margin: 0;
                padding: 0;
            }
            ul li {
                width: calc(50% - 1rem);
            }
            ul li * {
                text-decoration: none;
                transition: 0.2s ease;
            }
            ul li img {
                margin-bottom: 0.5rem;
                border-radius: 12px;
            }
            ul li a {
                display: block;
            }
            .title {
                margin: 0;
                color: rgb(var(--black));
                line-height: 1;
            }
            .date {
                margin: 0;
                color: rgb(var(--gray));
            }
            ul li a:hover .title,
            ul li a:hover .date {
                color: rgb(var(--accent));
            }
            footer {
                padding: 2rem;
                text-align: center;
                background-color: #ace1af;
                color: #1b3b2b;
                font-size: 0.9rem;
            }
            footer p {
                margin: 0.4rem 0;
            }
            footer a {
                color: #1b3b2b;
                text-decoration: underline;
            }
            .social-links {
                display: flex;
                justify-content: center;
                gap: 1.5rem;
                margin-top: 0.5rem;
            }
            @media (max-width: 720px) {
                ul {
                    gap: 0.5em;
                }
                ul li {
                    width: 100%;
                    text-align: center;
                }
            }
        </style>
    </head>
    <body>
        <header>
            <h2><a href="/">Projects</a></h2>
        </header>
        <main>
            <section>
                <ul>
                    {
                     posts.map((post) => (
                            <li>
                                <a href={`/blog/${post.id}/`}>
                                    <img width={720} height={360} src={post.data.heroImage.src} alt="" />
                                    <h4 class="title">{post.data.title}</h4>
                                    <p class="date">
                                        <FormattedDate date={post.data.pubDate} />
                                    </p>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </main>
        <footer>
            <p>Contact: <a href="mailto:CollinTCrews@gmail.com">CollinTCrews@gmail.com</a></p>
            <div class="social-links">
                <a href="www.linkedin.com/in/-collin-crews" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <a href="https://www.youtube.com/@Kiyrs" target="_blank" rel="noopener noreferrer">YouTube</a>
            </div>
        </footer>
    </body>
</html>