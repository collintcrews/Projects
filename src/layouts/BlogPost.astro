---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// Safe handling for heroImage whether it's an optimized image object or a string path
const imageSrc = typeof heroImage === 'object' && heroImage !== null 
    ? (heroImage as any).src 
    : heroImage;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
        <style>
            body {
                font-family: 'MyCustomFont', system-ui, -apple-system, sans-serif;
                margin: 0;
                padding: 0;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                color: rgb(var(--black));
                background: rgb(var(--background));
            }
            header {
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 2rem;
                background-color: #ace1af;
                color: #1b3b2b;
                border-bottom: 1px solid rgba(27, 59, 43, 0.1);
            }
            header h2 {
                margin: 0;
                font-size: 1.4rem;
                font-family: 'MyCustomFont', sans-serif;
                letter-spacing: 1px;
                text-align: center;
            }
            header h2 a {
                text-decoration: none;
                color: #1b3b2b;
                transition: opacity 0.2s ease;
            }
            header h2 a:hover {
                opacity: 0.75;
            }
            main {
                flex: 1;
                width: 960px;
                max-width: calc(100% - 2rem);
                margin: auto;
                padding: 3rem 0;
            }
            .prose {
                width: 720px;
                max-width: calc(100% - 2em);
                margin: auto;
                padding: 1em;
                color: rgb(var(--gray-dark));
            }

            /* Non-Sticky Shrinking Hero Image Styles */
            .hero-image {
                position: relative; /* Standard flow - moves up off-screen with scrolling */
                width: 100%;
                height: 510px;
                overflow: hidden;
                border-radius: 12px;
                text-align: center;
                margin-bottom: 2rem;
                transition: height 0.3s cubic-bezier(0.25, 1, 0.5, 1);
            }

            .hero-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 12px;
                transition: transform 0.3s ease;
            }

            /* Shrunk State when scroll begins */
            .hero-image.shrunk {
                height: 220px; /* Shrinks to a compact banner height while staying in flow */
            }

            .hero-image.shrunk img {
                transform: scale(1.02); /* Slight zoom accent while shrunk */
            }

            .title {
                margin-bottom: 1em;
                padding: 1em 0;
                text-align: center;
                line-height: 1;
            }
            .title h1 {
                margin: 0 0 0.5em 0;
            }
            .date {
                margin-bottom: 0.5em;
                color: rgb(var(--gray));
            }
            .last-updated-on {
                font-style: italic;
            }
            footer {
                padding: 2rem;
                text-align: center;
                background-color: #ace1af;
                color: #1b3b2b;
                font-size: 0.9rem;
            }
            footer p {
                margin: 0.4rem 0;
            }
            footer a {
                color: #1b3b2b;
                text-decoration: underline;
            }
            .social-links {
                display: flex;
                justify-content: center;
                gap: 1.5rem;
                margin-top: 0.5rem;
            }
            @media (max-width: 720px) {
                header h2 {
                    font-size: 1.1rem;
                }
                .hero-image {
                    height: 320px;
                }
                .hero-image.shrunk {
                    height: 160px;
                }
            }
        </style>
    </head> 
    <!-- Floating Links Menu Widget -->
<div class="floating-menu-container" id="floatingMenu">
    <button class="menu-toggle-btn" id="menuToggle" aria-label="Toggle Links Menu">
        +
    </button>
    <div class="menu-popup">
        <a href="https://www.linkedin.com/in/-collin-crews" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://www.youtube.com/@Kiyrs" target="_blank" rel="noopener noreferrer">YouTube</a>
        <a href="mailto:CollinTCrews@gmail.com">Email Me</a>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuContainer = document.getElementById('floatingMenu');
        const menuToggle = document.getElementById('menuToggle');

        if (!menuContainer || !menuToggle) return;

        menuToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            menuContainer.classList.toggle('active');
        });

        document.addEventListener('click', () => {
            if (menuContainer.classList.contains('active')) {
                menuContainer.classList.remove('active');
            }
        });
    });
</script>
        <body>
        <header>
            <h2><a href="/">Collin Crews - Project Portfolio</a></h2>
        </header>
        <main>
            <article>
                <div class="hero-image">
                    {imageSrc && <img width={1020} height={510} src={imageSrc} alt="" />}
                </div>
                <div class="prose">
                    <div class="title">
                        <div class="date">
                            <FormattedDate date={pubDate} />
                            {
                                updatedDate && (
                                    <div class="last-updated-on">
                                        Last updated on <FormattedDate date={updatedDate} />
                                    </div>
                                )
                            }
                        </div>
                        <h1>{title}</h1>
                        <hr />
                    </div>
                    <slot />
                </div>
            </article>
        </main>
        <footer>
            <p>Contact: <a href="mailto:CollinTCrews@gmail.com">CollinTCrews@gmail.com</a></p>
            <div class="social-links">
                <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <a href="https://youtube.com" target="_blank" rel="noopener noreferrer">YouTube</a>
            </div>
        </footer>

        <!-- Scroll listener script to trigger height shrink without sticking -->
        <script>
            window.addEventListener('DOMContentLoaded', () => {
                const heroImageContainer = document.querySelector('.hero-image');
                if (!heroImageContainer) return;

                const handleScroll = () => {
                    if (window.scrollY > 40) {
                        heroImageContainer.classList.add('shrunk');
                    } else {
                        heroImageContainer.classList.remove('shrunk');
                    }
                };

                window.addEventListener('scroll', handleScroll, { passive: true });
            });
        </script>
    </body>
</html>